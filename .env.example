# Host workflow only: under `make dev`, docker-compose points the app at its
# own db service instead.
DATABASE_URL=postgres://gothcc:gothcc@localhost/gothcc
LOG_LEVEL=info
ADDR=0.0.0.0:8000

# development, staging or production. Anything but production also sends
# X-Robots-Tag: noindex and a robots.txt that disallows everything (override
# with NO_INDEX=true|false).
APP_ENV=development

# Public origin for canonical and og:url links.
BASE_URL=http://localhost:8000
