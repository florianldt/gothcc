package components

import "example.com/gothcc/internal/view"

templ NotFound(p view.Page) {
	@Layout(p) {
		<div class="py-24 text-center">
			<p class="text-xs uppercase tracking-widest text-neutral-500 mb-3">404</p>
			<h1 class="text-4xl font-semibold tracking-tight text-neutral-900">Page not found</h1>
			<p class="mt-4 text-neutral-600">The page you are looking for does not exist or is no longer available.</p>
			<a href="/" class="mt-8 inline-block rounded-lg bg-neutral-900 px-4 py-2 text-sm font-medium text-white hover:bg-neutral-700">Back to home</a>
		</div>
	}
}

templ ServerError(p view.Page) {
	@Layout(p) {
		<div class="py-24 text-center">
			<p class="text-xs uppercase tracking-widest text-neutral-500 mb-3">500</p>
			<h1 class="text-4xl font-semibold tracking-tight text-neutral-900">Something went wrong</h1>
			<p class="mt-4 text-neutral-600">Please try again in a moment.</p>
			<a href="/" class="mt-8 inline-block rounded-lg bg-neutral-900 px-4 py-2 text-sm font-medium text-white hover:bg-neutral-700">Back to home</a>
		</div>
	}
}
