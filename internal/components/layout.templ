package components

// Layout is the base page wrapper. Content is passed as templ children, the
// equivalent of Askama's {% block content %}.
templ Layout(title, description string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<meta name="description" content={ description }/>
			<link rel="stylesheet" href="/static/css/app.css"/>
			<script src="https://unpkg.com/htmx.org@2.0.4"></script>
		</head>
		<body class="min-h-screen flex flex-col bg-neutral-50 text-neutral-900 font-sans">
			@Header()
			<main class="flex-1 w-full max-w-5xl mx-auto px-6 py-12">
				{ children... }
			</main>
			@Footer()
		</body>
	</html>
}
